# Переменные окружения для Docker Compose
# Скопируй этот файл в .env и настрой под себя

# ============================================================================
# ОСНОВНАЯ POSTGRESQL БАЗА (статьи, диалоги, пользователи)
# ============================================================================

# Пользователь PostgreSQL
POSTGRES_USER=postgres

# Пароль PostgreSQL (⚠️ ОБЯЗАТЕЛЬНО измени для production!)
POSTGRES_PASSWORD=postgres

# Название базы данных
POSTGRES_DB=legal_agent

# Порт PostgreSQL (по умолчанию 5432)
POSTGRES_PORT=5432

# ============================================================================
# ВЕКТОРНАЯ POSTGRESQL БАЗА (эмбеддинги для поиска)
# ============================================================================

# Пользователь для векторной БД
VECTOR_DB_USER=postgres

# Пароль для векторной БД
VECTOR_DB_PASSWORD=postgres

# Название векторной базы данных
VECTOR_DB_NAME=legal_agent_vectors

# Порт для векторной БД (по умолчанию 5433)
VECTOR_DB_PORT=5433

# ============================================================================
# АРХИТЕКТУРА
# ============================================================================

# Две отдельные БД для разделения ответственности:
#
# 1. legal_agent (порт 5432) - основные данные
#    - Таблицы: articles, conversations, messages, users
#    - Полнотекстовый поиск через pg_trgm
#    - Образ: postgres:16-alpine
#
# 2. legal_agent_vectors (порт 5433) - только векторы
#    - Таблица: article_vectors (id, article_id, embedding)
#    - Векторный поиск через pgvector
#    - Образ: pgvector/pgvector:pg16
#
# Преимущества:
# ✓ Независимое масштабирование
# ✓ Разные настройки производительности
# ✓ Легче backup/restore
# ✓ Изоляция нагрузки

# ============================================================================
# ПРИМЕЧАНИЯ
# ============================================================================

# 1. Скопируй этот файл:
#    cp docker/.env.example docker/.env
#
# 2. Измени POSTGRES_PASSWORD на надёжный пароль
#
# 3. Запусти Docker Compose:
#    cd docker
#    docker compose up -d
#
# 4. Проверь, что обе БД запустились:
#    docker compose ps
#    docker compose logs postgres
#    docker compose logs postgres_vector
#
# 5. Подключись к основной БД:
#    docker compose exec postgres psql -U postgres -d legal_agent
#
# 6. Подключись к векторной БД:
#    docker compose exec postgres_vector psql -U postgres -d legal_agent_vectors
