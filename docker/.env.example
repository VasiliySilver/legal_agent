# Переменные окружения для Docker Compose
# Скопируй этот файл в .env и настрой под себя

# ============================================================================
# POSTGRESQL НАСТРОЙКИ
# ============================================================================

# Пользователь PostgreSQL
POSTGRES_USER=postgres

# Пароль PostgreSQL (⚠️ ОБЯЗАТЕЛЬНО измени для production!)
POSTGRES_PASSWORD=postgres

# Название базы данных
POSTGRES_DB=legal_agent

# Порт PostgreSQL (по умолчанию 5432)
POSTGRES_PORT=5432

# ============================================================================
# ПРИМЕЧАНИЯ
# ============================================================================

# 1. Скопируй этот файл:
#    cp docker/.env.example docker/.env
#
# 2. Измени POSTGRES_PASSWORD на надёжный пароль
#
# 3. Запусти Docker Compose:
#    cd docker
#    docker compose up -d
#
# 4. Проверь, что БД запустилась:
#    docker compose ps
#    docker compose logs postgres
#
# 5. Подключись к БД:
#    docker compose exec postgres psql -U postgres -d legal_agent
