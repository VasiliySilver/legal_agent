# ============================================
# Legal Agent - Environment Configuration
# ============================================

# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_PROXY=socks5://127.0.0.1:12334/

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_agent

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# REST API Settings
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30.0

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_USER=10

RATE_LIMIT_WINDOW=60

# ==========================
# Vector index (optional)
# ==========================
# Backend to build the vector index for RAG: "faiss" or "postgres".
# If not set, the loader won't build a vector index automatically.
VECTOR_BACKEND=            # faiss | postgres

# For FAISS: path to save/load index (default: data/faiss_index)
VECTOR_INDEX_PATH=data/faiss_index

# For Postgres (pgvector): optional separate vector DB connection.
# If not set, the loader will try to reuse POSTGRES_* values.
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5433
VECTOR_DB_NAME=legal_agent_vectors
VECTOR_DB_USER=postgres
VECTOR_DB_PASSWORD=postgres
